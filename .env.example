# Local development defaults. Never enter real credentials in this template.
PORTFOLIO_ENV=development
ALLOWED_ORIGIN=http://localhost:4200
CONTACT_RECIPIENT_EMAIL=your-recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@example.com
SMTP_PASSWORD=replace-with-google-app-password
MAIL_FROM_ADDRESS=your-gmail-address@example.com
SMTP_TIMEOUT_SECONDS=10
CONTACT_RATE_LIMIT=5 per minute
RATELIMIT_STORAGE_URI=memory://

# Production: copy privately to /etc/portfolio-api/portfolio.env, then change:
# PORTFOLIO_ENV=production
# ALLOWED_ORIGIN=https://weimanndev.com
# RATE_LIMIT_DB=/var/lib/portfolio-api/rate-limits.sqlite3
# Production uses persistent SQLite, NOT RATELIMIT_STORAGE_URI/CONTACT_RATE_LIMIT.
# Production limits: 5 requests/IP/minute, 30 requests total/hour.
